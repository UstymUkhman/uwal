{
    "name": "UWAL",
    "readme": "none",
    "router": "module",
    "out": "./.vitepress",
    "useCodeBlocks": true,
    "hidePageTitle": true,
    "useHTMLAnchors": true,
    "disableSources": true,
    "cleanOutputDir": false,
    "entryFileName": "Modules",
    "jsDocCompatibility": true,
    "parametersFormat": "table",

    "plugin":
    [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme"
    ],

    "validation":
    {
        "notExported": false
    },

    "entryPoints":
    [
        "lib/Device.js",
        "lib/Errors.js",
        "lib/Scene.js"
    ]
}
