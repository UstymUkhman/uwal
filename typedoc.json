{
    "name": "UWAL",
    "readme": "none",
    "router": "module",
    "out": "./.vitepress",
    "useCodeBlocks": true,
    "hidePageTitle": true,
    "useHTMLAnchors": true,
    "disableSources": true,
    "cleanOutputDir": false,
    "entryFileName": "Modules",
    "jsDocCompatibility": true,
    "parametersFormat": "table",

    "plugin":
    [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme",
        "typedoc-plugin-no-inherit"
    ],

    "entryPoints":
    [
        "lib/Device.js",
        "lib/Scene.js",
        "lib/utils/Color.js",
        "lib/cameras/Camera2D.js",
        "lib/cameras/Camera3D.js",
        "lib/cameras/OrthographicCamera.js",
        "lib/cameras/PerspectiveCamera.js",
        "lib/lights/Light.js",
        "lib/lights/Ambient.js",
        "lib/lights/Directional.js",
        "lib/lights/Point.js",
        "lib/lights/Spot.js",
        "lib/textures/index.js",
        "lib/textures/Texture.js",
        "lib/textures/Constants.js",
        "lib/text/MSDFText.js",
        "lib/utils/Math.js",
        "lib/Errors.js"
    ],

    "sidebar":
    {
        "autoConfiguration": false
    },

    "validation":
    {
        "notExported": false
    },

    "groupOrder":
    [
        "Type Aliases",
        "Interfaces",
        "Classes",
        "Properties",
        "Constructors",
        "Methods",
        "Variables",
        "Functions",
        "*"
    ],

    "sort":
    [
        "static-first",
        "visibility",
        "source-order"
    ]
}
